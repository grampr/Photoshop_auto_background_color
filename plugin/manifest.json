{
  "manifestVersion": 5,
  "id": "com.local-auto-harmonize.photoshop",
  "name": "ローカル自動色合わせ",
  "version": "0.2.3",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:8765",
        "http://localhost:8765"
      ]
    },
    "launchProcess": {
      "schemes": ["localautoharmonize"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "autoHarmonizePanel",
      "label": { "default": "ローカル自動色合わせ" },
      "minimumSize": { "width": 280, "height": 520 },
      "preferredDockedSize": { "width": 320, "height": 680 }
    }
  ]
}
