{
  "manifestVersion": 5,
  "id": "com.local-auto-harmonize.photoshop",
  "name": "Local Auto Harmonize",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:8765",
        "http://localhost:8765"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "autoHarmonizePanel",
      "label": { "default": "Local Auto Harmonize" },
      "minimumSize": { "width": 280, "height": 520 },
      "preferredDockedSize": { "width": 320, "height": 680 }
    }
  ]
}

